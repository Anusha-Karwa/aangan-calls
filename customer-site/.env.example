# Customer site (Talk to Aangan). Copy to .env.local for local dev; set the same in the Vercel project.
# Same Vaani key + agent as the studio dashboard. Conversations reach the designer dashboard via the
# Vaani webhook (configured once in the Vaani dashboard), so this site needs no database.
VAANI_API_KEY=
VAANI_AGENT_ID=

# Optional: comma-separated background video URLs
TALK_VIDEO_URLS=
