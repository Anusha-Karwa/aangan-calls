# Customer site (Talk to Aangan). Copy to .env.local for local dev; set the same in its Vercel project.
# Same Vaani key + agent as the studio dashboard.
VAANI_API_KEY=
VAANI_AGENT_ID=

# Attaches the details a visitor types (name, email, phone) to their call on the studio dashboard.
# Must match VAANI_WEBHOOK_SECRET on the studio project. STUDIO_WEBHOOK_URL defaults to aangan-calls.vercel.app.
VAANI_WEBHOOK_SECRET=
STUDIO_WEBHOOK_URL=

# Optional: comma-separated background video URLs
TALK_VIDEO_URLS=
