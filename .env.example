# Copy to .env.local and fill in. Never commit real values.
# Any integration whose key is blank runs in MOCK / DRY-RUN mode: it logs what it
# would have sent instead of calling the real service. See SETUP.md.

# --- Vaani Labs (voice agent) ---
VAANI_API_KEY=
VAANI_AGENT_ID=
# Shared secret for the post-call webhook. Sent by Vaani as a header or ?secret= (see lib/vaani.ts).
VAANI_WEBHOOK_SECRET=
# Optional override of the Vaani API base URL
VAANI_API_BASE=
# Cost per call minute in INR, used for cost_inr
VAANI_RATE_INR=7

# --- Google Gemini (post-call extraction + simulated caller in tests) ---
GEMINI_API_KEY=
# Optional override; defaults to a current Flash model in lib/gemini.ts
GEMINI_MODEL=

# --- Cal.com (Vaani books natively; we only read bookings) ---
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_EVENT_DURATION_MIN=60
CALCOM_TIMEZONE=Asia/Kolkata
# Optional: secret for the Cal.com -> /api/calcom/webhook signature
CALCOM_WEBHOOK_SECRET=

# --- Resend (designer notification email) ---
RESEND_API_KEY=
# Until you verify a domain in Resend, onboarding@resend.dev can only deliver to your own Resend login email.
EMAIL_FROM=Aangan Studio <onboarding@resend.dev>
DESIGNER_EMAIL=
ESCALATION_EMAIL=
# Optional: also email the caller a short confirmation (true/false)
SEND_CALLER_CONFIRMATION=false

# --- HubSpot (Nikhil's pipeline) ---
HUBSPOT_TOKEN=
# Optional overrides; defaults are HubSpot's built-in "Sales Pipeline"
HUBSPOT_PIPELINE=default
HUBSPOT_STAGE_BOOKED=appointmentscheduled
HUBSPOT_STAGE_QUALIFIED=qualifiedtobuy

# --- Database (Neon by default; any Postgres URL works) ---
# Blank = local JSON file store in .data/ (dev only, not for Vercel)
DATABASE_URL=

# --- Dashboard ---
DASHBOARD_PASSWORD=
APP_BASE_URL=http://localhost:3000

# --- Optional ---
FRONT_DESK_NUMBER=
